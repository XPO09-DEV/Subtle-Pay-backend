NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=debug
# Comma-separated browser origins. Keep this exact for local Vite development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_PATH=./data/subtle.db

# Generate three distinct 32-byte hex secrets; never commit .env.
JWT_ACCESS_SECRET=
PASSWORD_PEPPER=
MASTER_KEY=

MONAD_RPC_URL=
MONAD_CHAIN_ID=10143
RELAYER_PRIVATE_KEY=

ALIAS_REGISTRY_ADDRESS=
PAYMENT_ROUTER_ADDRESS=
STABLE_TOKEN_ADDRESS=
