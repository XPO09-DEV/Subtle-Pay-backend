NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173

# WebAuthn passkeys: open the frontend using http://localhost:5174 in local development.
# Production must use HTTPS and the exact public frontend origin and its registrable RP domain.
WEBAUTHN_RP_NAME=Subtle Pay
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5174
DB_PATH=./data/subtle.db

# Generate three distinct 32-byte hex secrets. Never commit .env.
JWT_ACCESS_SECRET=
PASSWORD_PEPPER=
MASTER_KEY=

# Monad RPC and custodial transaction relayer.
MONAD_RPC_URL=
MONAD_CHAIN_ID=10143
MONAD_EXPLORER_URL=
RELAYER_PRIVATE_KEY=

# Deployment-specific contract addresses.
ALIAS_REGISTRY_ADDRESS=
PAYMENT_ROUTER_ADDRESS=
STABLE_TOKEN_ADDRESS=

# Server-only provider keys. Never prefix with VITE_.
ANKR_API_KEY=
COINSTATS_API_KEY=
COINSTATS_API_BASE_URL=https://openapiv1.coinstats.app

# Long random token for admin overview/export routes.
ADMIN_API_TOKEN=

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
